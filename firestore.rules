rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Analytics visit tracking. Anyone (even unauthenticated) can log
    // a visit. Shape validation prevents abuse. Read/update/delete
    // are blocked; only the admin Cloud Function reads this data
    // (with admin privileges that bypass rules).
    match /visits/{visitId} {
      allow create: if
        request.resource.data.keys().hasOnly(['visitorId', 'timestamp', 'path'])
        && request.resource.data.visitorId is string
        && request.resource.data.visitorId.size() < 100
        && request.resource.data.path is string
        && request.resource.data.path.size() < 500
        && request.resource.data.timestamp == request.time;
      allow read, update, delete: if false;
    }

    match /conversations/{conversationId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;

      // Clients can only update title and isArchived (rename/archive).
      // messageCount and lastMessageAt are managed by Cloud Functions.
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['userId', 'messageCount', 'lastMessageAt', 'createdAt']);

      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;

      // Conversations are created by Cloud Functions, not clients.
      // No client create rule needed.

      match /messages/{messageId} {
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/conversations/$(conversationId)).data.userId == request.auth.uid;

        // Messages are created by Cloud Functions only.
        // No client write rules needed.
      }
    }
  }
}
